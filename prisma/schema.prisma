// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 物流公司模型
model LogisticsCompany {
  id          String      @id @default(cuid())
  name        String      @unique
  color       String      @default("#000000")
  trackingUrl String      // 查询网址，后面拼接运单号
  sortOrder   Int         @default(0) // 排序序号，数字越小越靠前
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  trackings   Tracking[]
}

// 货代商模型
model Forwarder {
  id        String      @id @default(cuid())
  name      String      @unique
  color     String      @default("#000000")
  address   String?     // 货代商地址
  sortOrder Int         @default(0) // 排序序号，数字越小越靠前
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  trackings Tracking[]
}

// 运单状态枚举
enum TrackingStatus {
  PENDING    // 待处理
  TRANSIT    // 运输中
  DELIVERED  // 已签收
  EXCEPTION  // 异常
}

// 运单模型
model Tracking {
  id                String          @id @default(cuid())
  trackingNumber    String          @unique
  status            TrackingStatus  @default(PENDING)
  note              String?         // 备注
  isArchived        Boolean         @default(false)
  isUrgent          Boolean         @default(false)  // 是否加急
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lastSyncedAt      DateTime?
  lastSyncAttemptAt DateTime?
  lastSyncError     String?
  events            TrackingEvent[]
  
  // 关联物流公司
  logisticsCompany  LogisticsCompany? @relation(fields: [logisticsCompanyId], references: [id])
  logisticsCompanyId String?
  
  // 关联货代商
  forwarder         Forwarder?      @relation(fields: [forwarderId], references: [id])
  forwarderId       String?

  @@index([isArchived, status])
}

model AppSettings {
  id            String @id @default("default")
  scraperUrl    String @default("http://127.0.0.1:18080")
  dailySyncTime String @default("05:00")
}

model TrackingEvent {
  id          String    @id @default(cuid())
  trackingId  String
  eventKey    String
  occurredAt  DateTime?
  timeText    String?
  description String
  stage       String?
  location    String?
  tieOrder    Int       @default(0)
  tracking    Tracking  @relation(fields: [trackingId], references: [id], onDelete: Cascade)

  @@unique([trackingId, eventKey])
  @@index([trackingId, occurredAt])
}

model SyncJob {
  id          String    @id
  lastRunDate String?
  lockedUntil DateTime?
  lockToken   String?
  activeRunId String?
}

model SyncRun {
  id                    String   @id @default(cuid())
  trigger               String
  status                String
  total                 Int      @default(0)
  processed             Int      @default(0)
  succeeded             Int      @default(0)
  failed                Int      @default(0)
  skipped               Int      @default(0)
  startedAt             DateTime @default(now())
  finishedAt            DateTime?
  durationMs            Int?
  currentTrackingNumber String?
  stopRequested         Boolean  @default(false)
  error                 String?
  updatedAt             DateTime @updatedAt

  @@index([startedAt])
  @@index([status])
}
